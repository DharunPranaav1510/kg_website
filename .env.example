# Copy to .env.local (local) or add in Vercel -> Settings -> Environment Variables.
# Never commit real values. Anything starting with NEXT_PUBLIC_ is visible to every visitor.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SERVER ONLY. Full database access. Rotate it if it is ever shared or leaked.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Security ---
# Long random text used to anonymise visitor IPs (e.g. `openssl rand -hex 32`).
IP_HASH_SALT=
# Set to "true" to force every admin to set up two-step login before using the panel.
ADMIN_REQUIRE_MFA=false

# --- Optional: Cloudflare Turnstile (free CAPTCHA) for checkout + contact form ---
# Create a widget at https://dash.cloudflare.com/ -> Turnstile. Set BOTH to switch it on.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Optional: email (Resend) ---
RESEND_API_KEY=

# --- Under-development page ---
# Set to "true" on the server (e.g. Vercel) to show the "under development" page to everyone.
# Leave unset on your own machine to keep working normally.
MAINTENANCE_MODE=
# Optional: lets you preview the real site while it is hidden. Visit /?preview=<this key> once
# (12 hours), or /?preview=off to lock again. Use 8+ random characters.
MAINTENANCE_BYPASS_KEY=
# Optional: replace the default sentence on the page (max 240 characters).
MAINTENANCE_MESSAGE=
